{
  "expo": {
    "name": "WhoDoggy",
    "slug": "who-doggy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#BBD6EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anthonyprice.whodoggy",
      "infoPlist": {
        "NSCameraUsageDescription": "WhoDoggy requires camera access to scan microchip barcodes on veterinary paperwork and scanners."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#BBD6EF"
      },
      "package": "com.anthonyprice.whodoggy",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "WhoDoggy requires camera access to scan microchip barcodes on veterinary paperwork and scanners."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc799a20-aec3-4e53-9526-0cd1f2eb270d"
      }
    }
  }
}
